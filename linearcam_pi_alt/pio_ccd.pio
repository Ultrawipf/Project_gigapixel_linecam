.program ccdclock

; Generates 6MHz main clock.

;set pindirs, 1   ; Set pin to output
.wrap_target
    set pins 1
    set pins 0
.wrap



% c-sdk {
    #include "hardware/clocks.h"
    #include "hardware/gpio.h"
    static inline void ccdclock_program_init(PIO pio, uint sm, uint offset, uint pin, float freq) {
        pio_sm_config c = ccdclock_program_get_default_config(offset);
        pio_gpio_init(pio, pin);
        // Set the pin direction to output at the PIO
        pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

        // Enable set pins (NOT OUT)
        sm_config_set_set_pins(&c, pin,1);

        // Init before clock
        pio_sm_init(pio, sm, offset, &c);

        // Setup clock
        float div = clock_get_hz(clk_sys) / (freq * 2.0f);
        pio_sm_set_clkdiv(pio, sm, div);
        // pio_sm_set_enabled(pio, sm, true);
}
%}


.program ccddata

; Reads 8b wide data

.side_set 1
;set pins 8 side 0 [15]
;set pins 0 side 0 [15]
;wait 1 pin 9 side 0 [15]
;nop side 0 [15]
.wrap_target
    wait 1 pin 8 side 0
    ;nop side 0
    in pins 10 side 1
    
    wait 0 pin 8 side 1
    nop side 1
    ;in pins 8 side 0 ; Requires faster PIO DMA for 16b
    ;push block side 0
.wrap



% c-sdk {
    #include "ccd_constants.h"
    static inline void ccddata_program_init(PIO pio, uint sm, uint offset, uint dpinbase, float freq) {
        pio_sm_config c = ccddata_program_get_default_config(offset);
        for(uint i = dpinbase; i<dpinbase+10; i++){
            pio_gpio_init(pio, i);
        }
        //pio_gpio_init(pio, dpinbase+9);
        //pio_sm_set_consecutive_pindirs(pio,sm,dpinbase+9,1,true); // Out tg

        #ifdef DATADBGPIN
        pio_gpio_init(pio, DATADBGPIN);
        #endif
        // Set the pin direction to input at the PIO
        pio_sm_set_consecutive_pindirs(pio, sm, dpinbase, 10, false); // Do not override clock pin dirs maybe
        sm_config_set_in_pins(&c, dpinbase); // for WAIT, IN
        #ifdef DATADBGPIN
            pio_sm_set_consecutive_pindirs(pio, sm, DATADBGPIN, 1, true);
            sm_config_set_sideset_pins(&c, DATADBGPIN); // debug pin
        #endif

        sm_config_set_set_pins(&c, dpinbase+6,4); // Dummy set pins for data output

        sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
        sm_config_set_in_shift(&c, false, true, 30); // In Shift | shift_direction=right, autopush=true, push_threshold=30

        //hw_set_bits(&pio->input_sync_bypass, 0x3ffu << dpinbase);
        // Init before clock
        pio_sm_init(pio, sm, offset, &c);

        // Setup clock
        if(freq == 0.0f){
            pio_sm_set_clkdiv(pio, sm, 0);
        }else{
            float div = clock_get_hz(clk_sys) / (freq * 2.0f);
            pio_sm_set_clkdiv(pio, sm, div);
        }
        
        // pio_sm_set_enabled(pio, sm, true);
}

    static inline void ccddata_program_deinit(PIO pio, uint sm, uint offset, uint dpinbase){
        #ifdef DATADBGPIN
        pio_sm_set_consecutive_pindirs(pio, sm, DATADBGPIN, 1, false);
        #endif
    }
%}

